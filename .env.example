# ---- Model -----------------------------------------------------------------
# Leave empty to run the zero-cost heuristic stand-in.
ANTHROPIC_API_KEY=
# SWITCHBOARD_MODEL=claude-opus-5        # or claude-sonnet-5, or heuristic

# ---- Slack (write; held by the executor) -----------------------------------
# Either a bot token (posts to per-team channels the bot is in) ...
SLACK_BOT_TOKEN=
# ... or an incoming webhook (posts to the webhook's channel, prefixed with the intended one).
SLACK_WEBHOOK_URL=

# ---- GitHub (read; CODEOWNERS, catalog.yaml, deploy history) ---------------
GITHUB_TOKEN=
GITHUB_REPO=owner/name
GITHUB_REF=main
GITHUB_CATALOG=catalog.yaml
# python -m switchboard.sync pulls these into .switchboard-cache/, which the loaders prefer over fixtures/.

# ---- Email (IMAP read for the pipeline, SMTP write for the executor) -------
# Gmail: enable 2-step verification, create an App Password, use it for both.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
